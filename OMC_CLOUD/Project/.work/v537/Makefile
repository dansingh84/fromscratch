CC ?= gcc
CFLAGS ?= -O2 -g -std=c11 -Wall -Wextra -Iinclude

# Gate binaries only.  tests/test_xsl.c calls setenv()/unsetenv() to drive the
# environment knobs it asserts on.  Those are POSIX, not ISO C, so under a
# strict -std=c11 front end they are not declared and the build fails outright
# (adversarial review 7.6-7.8).  GCC with default glibc headers happens to
# expose them anyway, which is why this was invisible until the tree was built
# with a different toolchain.  The codec sources stay strictly C11.
TCFLAGS = $(CFLAGS) -D_POSIX_C_SOURCE=200809L
SRC = src/dwt.c src/tans.c src/bitio.c src/alloc.c src/codec.c src/tables.c src/config.c src/upconv.c src/colour.c src/ddr_model.c   # [D-DDR]
OBJ = $(SRC:.c=.o)

all: omc_enc omc_dec test_unit test_uc test_cc test_cap test_xsl omc_uc_tool omc_unblend_tool omc_ddr_sweep omc_pack omc_depack omc_pixpack omc_pixunpack

%.o: %.c src/latt_probe.inc include/omc1.h include/tables.h include/omc_uc.h include/omc_cc.h src/internal.h src/uc_poly_tab.c.inc src/cc_tab.c.inc src/gm_basis_tab.c.inc
	$(CC) $(CFLAGS) -c $< -o $@

# The in-gamut repair's synthesis-basis sign table is MEASURED from the
# shipping inverse transform rather than transcribed from a derivation, and
# it is regenerated by the build so it cannot drift: change a lifting step in
# src/dwt.c and this table is rebuilt before anything links against it.
gen_gm_basis: repro/gen_gm_basis.c src/dwt.c include/omc1.h src/internal.h
	$(CC) $(CFLAGS) repro/gen_gm_basis.c src/dwt.c -o $@ -lm

src/gm_basis_tab.c.inc: gen_gm_basis
	./gen_gm_basis > $@.new && mv $@.new $@

omc_enc: tools/omc_enc.c $(OBJ)
	$(CC) $(CFLAGS) $^ -o $@ -lm

omc_dec: tools/omc_dec.c $(OBJ)
	$(CC) $(CFLAGS) $^ -o $@ -lm

omc_uc_tool: tools/omc_uc_tool.c $(OBJ)
	$(CC) $(CFLAGS) $^ -o $@ -lm


test_unit: tests/test_unit.c $(OBJ)
	$(CC) $(TCFLAGS) $^ -o $@ -lm

test_cap: tests/test_cap.c $(OBJ)
	$(CC) $(TCFLAGS) $< $(OBJ) -o $@ -lm

test_xsl: tests/test_xsl.c $(OBJ)
	$(CC) $(TCFLAGS) $< $(OBJ) -o $@ -lm

omc_unblend_tool: tools/omc_unblend_tool.c $(OBJ)
	$(CC) $(CFLAGS) $< $(OBJ) -o $@ -lm

test_uc: tests/test_uc.c $(OBJ)
	$(CC) $(TCFLAGS) $^ -o $@ -lm


test_cc: tests/test_cc.c $(OBJ)
	$(CC) $(TCFLAGS) $^ -o $@ -lm

test: test_unit test_uc test_cc test_cap test_xsl omc_enc
	./test_unit
	./test_uc
	./test_cap
	./test_xsl
	./test_cc
	@sh tests/restore_check.sh
	@sh tests/cut24_cli.sh
	@sh tests/refcheck.sh
	@# sect.11.5d M1: a lever that cannot change the output is dead code or a
	@# broken edit, and no measurement taken with it means anything.  Needs two
	@# arms (a slice_h>=16 rung and a slice_h<=8 one) because several v5.3 levers
	@# stand down at the short rung by design; set OMC_LEVERCHECK_ARMS to the six
	@# +six arguments tests/levercheck.sh documents.  Skipped, loudly, without them.
	@if [ -n "$$OMC_LEVERCHECK_ARMS" ]; then \
		sh tests/levercheck.sh $$OMC_LEVERCHECK_ARMS; \
	 else \
		echo "SKIP: levercheck -- set OMC_LEVERCHECK_ARMS='TALL.yuv W H FMT DEPTH BPP SHORT.yuv W H FMT DEPTH BPP' to run it (sect.11.5d M1)"; \
	 fi

# [V535] Agent 4 Task D tools (packet path, pixel path, DDR service model)
omc_ddr_sweep: tools/omc_ddr_sweep.c src/ddr_model.c src/ddr_model.h
	$(CC) $(TCFLAGS) tools/omc_ddr_sweep.c src/ddr_model.c -o $@ -lm

omc_pack: tools/omc_pack.c tools/omc_pkt.h
	$(CC) $(TCFLAGS) tools/omc_pack.c -o $@

omc_depack: tools/omc_depack.c tools/omc_pkt.h
	$(CC) $(TCFLAGS) tools/omc_depack.c -o $@

omc_pixpack: tools/omc_pixpack.c tools/omc_pix.h
	$(CC) $(TCFLAGS) tools/omc_pixpack.c -o $@

omc_pixunpack: tools/omc_pixunpack.c tools/omc_pix.h
	$(CC) $(TCFLAGS) tools/omc_pixunpack.c -o $@

clean:
	rm -f $(OBJ) omc_enc omc_dec omc_ddr_sweep omc_pack omc_depack omc_pixpack omc_pixunpack test_unit omc_uc_tool omc_unblend_tool test_uc test_cc test_cap test_xsl gen_gm_basis

.PHONY: all test clean

# optional concurrency proof: two encoder threads under ThreadSanitizer,
# output must byte-match sequential runs (requires -fsanitize=thread support)
test-threads: tests/test_threads.c $(SRC)
	cc -fsanitize=thread -g -O1 -std=c11 -Iinclude -o test_threads tests/test_threads.c $(SRC) -lpthread
	./test_threads
